{
  "name": "valuebridge-360",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src generator analytics tests playwright.config.mjs vite.config.ts",
    "preview": "vite preview",
    "generate:data": "tsc -p tsconfig.generator.json && node generator-dist/generator/generate.js",
    "generate:synthetic-transactions": "node analytics/python_runtime.mjs analytics/generate_synthetic_transactions.py",
    "validate:synthetic-source": "node analytics/python_runtime.mjs analytics/validate_synthetic_source.py",
    "test:synthetic-source": "node analytics/python_runtime.mjs -m unittest discover -s tests/python -v",
    "export:analytics": "node analytics/python_runtime.mjs analytics/export_dashboard.py",
    "validate:data": "node analytics/validate_outputs.mjs",
    "rollback:analytics": "node analytics/python_runtime.mjs analytics/activate_snapshot.py",
    "profile:csv": "python analytics/profile_csv.py",
    "test:stage1": "tsc -p tsconfig.generator.json && node --test tests/stage1.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
